{
  "name": "lizmap/streaming-json-encoder",
  "description": "Library for iteratively encoding large JSON documents piece by piece (maintained fork)",
  "license": "MIT",
  "type": "library",
  "keywords": [
    "streaming",
    "json",
    "encoder",
    "psr-7"
  ],
  "authors": [
    {
      "name": "Riikka Kalliomäki",
      "email": "riikka.kalliomaki@gmail.com",
      "homepage": "http://riimu.net"
    },
    {
      "name": "Laurent Jouanneau",
      "email": "ljouanneau@3liz.com",
      "homepage": "https://3liz.com"
    }
  ],
  "require": {
    "php": ">=8.0",
    "psr/http-message": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Violet\\StreamingJsonEncoder\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Violet\\StreamingJsonEncoder\\": "tests/tests/",
      "Violet\\StreamingJsonEncoder\\Test\\": "tests/classes/"
    }
  },
  "scripts": {
    "ci-all": [
      "composer test -- --do-not-cache-result",
      "composer phpcs -- --no-cache",
      "composer php-cs-fixer -- --dry-run --diff --using-cache=no",
      "composer normalize --dry-run"
    ],
    "php-cs-fixer": "php-cs-fixer fix -v",
    "phpcs": "phpcs -p",
    "test": "phpunit"
  }
}
